# Browserless Configuration

# WebSocket URL to your browserless instance
# Examples:
#   - Local: ws://localhost:3000
#   - Remote: wss://your-browserless-instance.com
BROWSERLESS_URL=ws://localhost:3000

# Optional: API key for remote browserless instances
# Required if using browserless.io or similar services
BROWSERLESS_API_KEY=

# Optional: Custom timeout for browser operations (in milliseconds)
# Default: 30000 (30 seconds)
BROWSERLESS_TIMEOUT=30000

# Optional: SearXNG instance URL
# When set, takes priority over DuckDuckGo for search
# Example: http://localhost:8888
SEARXNG_URL=

# Optional: Basic auth credentials for SearXNG
# Leave both empty if SearXNG doesn't require authentication
SEARXNG_BASIC_USER=
SEARXNG_BASIC_PASSWORD=
